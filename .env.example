# ===================================================
# HindiVoice AI - Environment Configuration
# ===================================================

# [OPTIONAL] Google Gemini API Key (Google AI Studio / Pro Plan)
# Simply paste your API key below (e.g. AIzaSy...).
# When set, HindiVoice AI will automatically switch to Google Gemini 3.8 Flash TTS
# (gemini-3.8-flash-tts) for studio-grade voice quality and expressive acting!
# If left blank, it automatically falls back to the free local neural engine.
GEMINI_API_KEY=

# Gemini TTS Model (Default: gemini-3.8-flash-tts)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False
